def run_part_b():
    print("\n" + "="*60)
    print("PART B — Pre-Earnings IV Collapse Backtest")
    print("="*60)

    trades = run_earnings_backtest_synthetic(
        ticker='QQQ', lookback_years=3,
        ep_threshold=0.03, bid_ask_cost=0.002
    )

    if trades.empty:
        print("  No trades generated — check data availability.")
        return

