    colors  = ['#185FA5', '#1D9E75', '#993C1D']
    labels  = ['BS delta hedge', 'Merton delta hedge', 'MV hedge (Merton)']
    keys    = ['bs_delta', 'merton_delta', 'mv_hedge']

    stats_rows = []
    for ax, key, color, label in zip(axes, keys, colors, labels):
        data = pnl[key]
        ax.hist(data, bins=80, color=color, alpha=0.75, density=True, edgecolor='none')
        ax.axvline(0, color='black', lw=1, ls='--', alpha=0.6)
        ax.set_title(label, fontsize=11)
        ax.set_xlabel("P&L ($)")
        ax.set_ylabel("Density")

        mu_val  = np.mean(data)
        std_val = np.std(data)
        kurt    = kurtosis(data, fisher=True)  # excess kurtosis; Gaussian = 0
        q5      = np.percentile(data, 5)

        ax.text(0.03, 0.97, f"mean = {mu_val:.3f}\nstd  = {std_val:.3f}\nkurt = {kurt:.2f}\nVaR5%= {q5:.3f}",
                transform=ax.transAxes, va='top', fontsize=9,
                bbox=dict(boxstyle='round,pad=0.3', fc='white', alpha=0.8))

        stats_rows.append(dict(strategy=label, mean=round(mu_val, 4),
                               std=round(std_val, 4), kurtosis=round(kurt, 3),
                               VaR_5pct=round(q5, 4)))

    plt.tight_layout()
    path = f"{out_dir}/pnl_distributions.png"
    fig.savefig(path, dpi=150, bbox_inches='tight')
    plt.close()
    print(f"  Saved: {path}")

    # 5% left-tail overlay
    fig2, ax2 = plt.subplots(figsize=(8, 5))
    for key, color, label in zip(keys, colors, labels):
        data = pnl[key]
        q5   = np.percentile(data, 5)
        tail = data[data <= q5]
        ax2.hist(tail, bins=40, color=color, alpha=0.6, label=label, density=True)
    ax2.set_title("5% Left Tail of P&L — Three Hedging Strategies")
    ax2.set_xlabel("P&L ($)")
    ax2.set_ylabel("Density")
    ax2.legend()
    path2 = f"{out_dir}/pnl_left_tail.png"
    fig2.savefig(path2, dpi=150, bbox_inches='tight')
    plt.close()
    print(f"  Saved: {path2}")

    # Save stats table
    stats_df = pd.DataFrame(stats_rows)
    csv_path = f"{out_dir}/hedging_stats.csv"
    stats_df.to_csv(csv_path, index=False)
    print(f"  Saved: {csv_path}")
    print("\n  Hedging statistics:")
    print(stats_df.to_string(index=False))

    return stats_df


