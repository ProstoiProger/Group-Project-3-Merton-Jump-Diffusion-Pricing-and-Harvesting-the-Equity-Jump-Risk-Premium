def bs_call(S, K, T, r, sigma):
    """Black-Scholes European call price."""
    if T <= 0:
        return max(S - K, 0.0)
    d1 = (np.log(S / K) + (r + 0.5 * sigma**2) * T) / (sigma * np.sqrt(T))
    d2 = d1 - sigma * np.sqrt(T)
    return S * norm.cdf(d1) - K * np.exp(-r * T) * norm.cdf(d2)


def bs_delta(S, K, T, r, sigma):
    """Black-Scholes delta = dC/dS."""
    if T <= 0:
        return 1.0 if S > K else 0.0
    d1 = (np.log(S / K) + (r + 0.5 * sigma**2) * T) / (sigma * np.sqrt(T))
    return norm.cdf(d1)


def merton_call(S, K, T, r, sigma, lam, mu_J, sigma_J, n_terms=30):
    """
    Merton (1976) analytic call price — Poisson-weighted sum of BS prices.
    C^Merton = sum_{n=0}^inf  e^{-lambda'T}(lambda'T)^n/n!  * C^BS(rn, sigma_n)
    """
    if T <= 0:
        return max(S - K, 0.0)
    mu_bar = np.exp(mu_J + 0.5 * sigma_J**2) - 1.0
    lam_prime = lam * (1.0 + mu_bar)
    price = 0.0
    log_poisson = -lam_prime * T   # log of e^{-lam'T}
    for n in range(n_terms):
        # Poisson weight: e^{-lam'T} (lam'T)^n / n!
        if n == 0:
            log_w = log_poisson
        else:
            log_w = log_poisson + n * np.log(lam_prime * T) - sum(np.log(range(1, n + 1)))
        w = np.exp(log_w)
        if w < 1e-12:
            break
        r_n   = r - lam * mu_bar + n * mu_J / T + n * sigma_J**2 / (2 * T)
        sig_n = np.sqrt(sigma**2 + n * sigma_J**2 / T)
        price += w * bs_call(S, K, T, r_n, sig_n)
    return price


def merton_delta(S, K, T, r, sigma, lam, mu_J, sigma_J, dS=0.01, n_terms=30):
    """Merton delta by central finite difference."""
    up   = merton_call(S * (1 + dS), K, T, r, sigma, lam, mu_J, sigma_J, n_terms)
    down = merton_call(S * (1 - dS), K, T, r, sigma, lam, mu_J, sigma_J, n_terms)
    return (up - down) / (2 * S * dS)


def mv_delta(S, K, T, r, sigma, lam, mu_J, sigma_J, n_terms=30):
    """
    Minimum-variance hedge ratio (Merton 1976):
        Delta^MV = dC/dS + lambda * E[(e^J - 1) * DeltaC_jump] / (sigma^2 * S)

    DeltaC_jump = C(S*e^J, K, T, r, sigma, ...) - C(S, K, T, r, sigma, ...)
    We estimate E[(e^J-1)*DeltaC_jump] by numerical integration over J ~ N(muJ, sigJ^2).
    """
    base_delta = merton_delta(S, K, T, r, sigma, lam, mu_J, sigma_J, n_terms)
    # Gauss-Hermite quadrature points for J ~ N(mu_J, sigma_J^2)
    n_pts = 20
    js, wts = np.polynomial.hermite.hermgauss(n_pts)
    js = js * np.sqrt(2) * sigma_J + mu_J   # transform to N(mu_J, sigma_J^2)
    wts = wts / np.sqrt(np.pi)

    correction_num = 0.0
    C0 = merton_call(S, K, T, r, sigma, lam, mu_J, sigma_J, n_terms)
    for j_val, w in zip(js, wts):
        S_jump = S * np.exp(j_val)
        C_jump = merton_call(S_jump, K, T, r, sigma, lam, mu_J, sigma_J, n_terms)
        delta_C = C_jump - C0
        correction_num += w * (np.exp(j_val) - 1) * delta_C

    correction = lam * correction_num / (sigma**2 * S)
    return base_delta + correction


def implied_vol(price, S, K, T, r, tol=1e-6):
    """Invert BS formula for implied vol by bisection."""
    intrinsic = max(S - K * np.exp(-r * T), 0)
    if price <= intrinsic + 1e-8:
        return np.nan
    try:
        return brentq(lambda sig: bs_call(S, K, T, r, sig) - price,
                      1e-4, 5.0, xtol=tol)
    except Exception:
        return np.nan


