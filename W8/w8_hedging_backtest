    n      = len(trades)
    wins   = (trades['net_pnl'] > 0).sum()
    sharpe = compute_sharpe(trades['net_pnl'])
    print(f"\n  Trades: {n}  |  Win rate: {wins/n*100:.1f}%  |  Sharpe: {sharpe:.2f}")
    print(f"  Mean P&L: ${trades['net_pnl'].mean():.4f}  |  Std: ${trades['net_pnl'].std():.4f}")

    # Market returns for factor regression
    try:
        mkt_df = yf.download('QQQ', period='3y', auto_adjust=True, progress=False)
        mkt_ret = mkt_df['Close'].pct_change().dropna()
        mkt_ret.index = pd.to_datetime(mkt_ret.index).date
    except Exception:
        mkt_ret = None

    reg = factor_regression(trades, mkt_ret)
    if reg:
        print("\n  Factor regression:")
        for k, v in reg.items():
            print(f"    {k:20s} = {v:.4f}")
        reg_df = pd.DataFrame([reg])
        reg_df.to_csv(f"{OUT}/factor_regression.csv", index=False)
        print(f"  Regression saved: {OUT}/factor_regression.csv")

    # Plots
    plot_earnings_results(trades, OUT)

    # Merton earnings-specific lambda
    p = PARAMS
    mu_bar = np.exp(p['mu_J'] + 0.5 * p['sigma_J']**2) - 1.0
    avg_move = trades['move_pct'].abs().mean() / 100
    lam_earnings = max(avg_move**2 / (p['sigma_J']**2 + p['mu_J']**2 + 1e-9), 0.1)
    print(f"\n  Estimated earnings-specific lambda: {lam_earnings:.3f}")
    print(f"  Background lambda (W6):             {p['lam']:.4f}")
    print(f"  Jump risk premium kappa:             {p['kappa']:.4f}")

    return trades


