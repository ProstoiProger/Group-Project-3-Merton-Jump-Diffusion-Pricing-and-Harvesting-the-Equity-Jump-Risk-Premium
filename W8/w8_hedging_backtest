def simulate_merton_path(S0, T, r, sigma, lam, mu_J, sigma_J, n_steps, rng):
    """Simulate one Merton path; return price array and jump times."""
    dt = T / n_steps
    S  = np.empty(n_steps + 1)
    S[0] = S0
    mu_bar = np.exp(mu_J + 0.5 * sigma_J**2) - 1.0
    drift  = (r - lam * mu_bar - 0.5 * sigma**2) * dt

    jump_times = []
    for i in range(n_steps):
        z  = rng.standard_normal()
        n_jumps = rng.poisson(lam * dt)
        j_sum = 0.0
        for _ in range(n_jumps):
            j_sum += rng.normal(mu_J, sigma_J)
            jump_times.append(i * dt)
        S[i + 1] = S[i] * np.exp(drift + sigma * np.sqrt(dt) * z + j_sum)
    return S, jump_times


def run_hedging_simulation(n_paths=5_000, n_steps=252, T=1.0,
                           S0=100.0, K=100.0):
    """
    Simulate P&L for three hedging strategies over n_paths Merton paths.
    Returns dict of P&L arrays: {'bs_delta', 'merton_delta', 'mv_hedge'}
    """
    p = PARAMS
    r, sigma, lam, mu_J, sigma_J = p['r'], p['sigma'], p['lam'], p['mu_J'], p['sigma_J']
    dt = T / n_steps

    pnl = {'bs_delta': [], 'merton_delta': [], 'mv_hedge': []}

    # Initial option prices under each model
    C0_bs     = bs_call(S0, K, T, r, sigma)
    C0_merton = merton_call(S0, K, T, r, sigma, lam, mu_J, sigma_J)

    print(f"  Running {n_paths} paths × {n_steps} steps...")
    rng = np.random.default_rng(42)

    for trial in range(n_paths):
        if trial % 1000 == 0:
            print(f"    path {trial}/{n_paths}")

        S_path, _ = simulate_merton_path(S0, T, r, sigma, lam, mu_J, sigma_J, n_steps, rng)

        # Each strategy: sell the option at t=0, delta-hedge dynamically,
        # close at T. P&L = collected premium + hedge gains - option payoff.
        for strat in pnl:
            cash = C0_merton   # premium received at t=0
            shares = 0.0       # shares held (positive = long stock)

            for i in range(n_steps):
                t_i = i * dt
                tau = T - t_i
                S_i = S_path[i]

                # Compute hedge ratio
                if strat == 'bs_delta':
                    delta = bs_delta(S_i, K, tau, r, sigma)
                elif strat == 'merton_delta':
                    delta = merton_delta(S_i, K, tau, r, sigma, lam, mu_J, sigma_J)
                else:
                    delta = mv_delta(S_i, K, tau, r, sigma, lam, mu_J, sigma_J)

                # Rebalance: buy/sell (delta - shares) units of stock
                trade = delta - shares
                cash -= trade * S_i          # cash decreases when buying stock
                cash *= np.exp(r * dt)       # interest on cash position
                shares = delta

            # At expiry: close stock position, pay option payoff
            S_T = S_path[-1]
            cash += shares * S_T             # sell remaining shares
            payoff = max(S_T - K, 0.0)
            cash -= payoff                   # pay option holder

            pnl[strat].append(cash)

    for k in pnl:
        pnl[k] = np.array(pnl[k])

    return pnl


def plot_pnl_distributions(pnl, out_dir):
    """Plot P&L distributions for all three hedging strategies."""
    fig, axes = plt.subplots(1, 3, figsize=(15, 5), sharey=False)
