def get_earnings_dates(ticker, start, end):
    """
    Fetch earnings announcement dates via yfinance.
    Returns list of datetime.date objects.
    """
    try:
        tk = yf.Ticker(ticker)
        cal = tk.calendar
        # yfinance returns calendar as dict with 'Earnings Date' key
        if cal is not None and 'Earnings Date' in cal:
            dates = cal['Earnings Date']
            if hasattr(dates, '__iter__'):
                return [d.date() if hasattr(d, 'date') else d for d in dates
                        if start <= (d.date() if hasattr(d, 'date') else d) <= end]
    except Exception:
        pass
    return []


def get_price_history(ticker, start, end):
    """Download daily OHLCV data."""
    df = yf.download(ticker, start=start, end=end, auto_adjust=True, progress=False)
    df = df[['Close', 'Open']].copy()
    df.columns = ['close', 'open']
    df.index = pd.to_datetime(df.index).date
    return df


def estimate_realised_vol(prices, window=21):
    """21-day rolling realized vol from log returns."""
    log_ret = np.log(prices / prices.shift(1)).dropna()
    rv = log_ret.rolling(window).std() * np.sqrt(252)
    return rv


def synthetic_iv_near(S, prices, t_minus1_date, window=5):
    """
    Proxy for implied vol: use realized vol over next `window` days
    after announcement as near-expiry IV.  In a real backtest this
    would be replaced with actual option chain data.
    """
    idx = list(prices.index)
    try:
        pos = idx.index(t_minus1_date)
    except ValueError:
        return np.nan, np.nan
    near_window = prices.iloc[pos + 1: pos + 1 + window + 1]
    if len(near_window) < 2:
        return np.nan, np.nan
    log_rets = np.log(near_window / near_window.shift(1)).dropna()
    iv_near = log_rets.std() * np.sqrt(252)
    # next-expiry IV: longer window realized
    far_window = prices.iloc[pos + window + 1: pos + window + 1 + 21]
    if len(far_window) < 2:
        return iv_near, iv_near
    log_rets2 = np.log(far_window / far_window.shift(1)).dropna()
    iv_far = log_rets2.std() * np.sqrt(252)
    return float(iv_near), float(iv_far)


def straddle_pnl(S_entry, S_exit, iv_entry, T_entry=1/12, r=0.05):
    """
    Short straddle P&L:
      sell ATM call + sell ATM put at t=-1 (price = 2 * BS_call for ATM)
      buy back at t=+1 open
    P&L = premium_collected - cost_to_close
    """
    K = S_entry  # ATM at entry
    T_exit = max(T_entry - 2/252, 1/252)

    # Entry: sell straddle at IV_entry
    call_entry = bs_call(S_entry, K, T_entry, r, iv_entry)
    put_entry  = bs_call(S_entry, K, T_entry, r, iv_entry)   # put ≈ call at ATM
    premium = call_entry + put_entry    # received

    # Exit: buy back at realized move
    call_exit = max(S_exit - K, 0.0)
    put_exit  = max(K - S_exit, 0.0)
    cost = call_exit + put_exit         # paid

    return premium - cost


def run_earnings_backtest_synthetic(ticker='QQQ', lookback_years=3,
                                    ep_threshold=0.05, bid_ask_cost=0.002):
    """
    Synthetic earnings backtest using realized-vol proxy for IV.
    In production, replace synthetic_iv_near() with real option chain data.
    """
    end_date   = datetime.today().date()
    start_date = end_date - timedelta(days=lookback_years * 365)

    print(f"  Downloading {ticker} price history {start_date} → {end_date}...")
    prices_df = get_price_history(ticker, str(start_date), str(end_date))
    if prices_df.empty:
        print("  ERROR: could not download price data.")
        return pd.DataFrame()

    prices = prices_df['close']
    opens  = prices_df['open']

    # Earnings dates — try yfinance; fall back to synthetic quarterly dates
    earnings = get_earnings_dates(ticker, start_date, end_date)
    if not earnings:
        print("  yfinance calendar unavailable — using synthetic quarterly dates")
        earnings = pd.date_range(start_date, end_date, freq='QS').date.tolist()

    price_idx = list(prices.index)
    trades = []

    for ann_date in earnings:
        # Find t=-1 (trading day before announcement)
        try:
            pos = price_idx.index(ann_date)
        except ValueError:
            # find nearest trading day
            candidates = [d for d in price_idx if d <= ann_date]
            if not candidates:
                continue
            pos = price_idx.index(candidates[-1])

        if pos < 21 or pos + 2 >= len(price_idx):
            continue

        t_minus1 = price_idx[pos - 1]
        t_plus1  = price_idx[pos + 1] if pos + 1 < len(price_idx) else None
        if t_plus1 is None:
            continue

        S_entry = float(prices.iloc[pos - 1])
        S_exit  = float(opens.iloc[pos + 1]) if not np.isnan(opens.iloc[pos + 1]) else float(prices.iloc[pos + 1])

        iv_near, iv_far = synthetic_iv_near(S_entry, prices, t_minus1)
        if np.isnan(iv_near) or np.isnan(iv_far):
            continue

        EP = iv_near - iv_far   # earnings premium
        if EP < ep_threshold:
            continue            # skip if premium too small

        raw_pnl = straddle_pnl(S_entry, S_exit, iv_near)
        net_pnl = raw_pnl - bid_ask_cost * S_entry   # transaction costs

        move_pct = (S_exit - S_entry) / S_entry * 100
        trades.append(dict(
            ann_date=ann_date,
            t_minus1=t_minus1,
            t_plus1=t_plus1,
            S_entry=round(S_entry, 2),
            S_exit=round(S_exit, 2),
            iv_near=round(iv_near, 4),
            iv_far=round(iv_far, 4),
            EP=round(EP, 4),
            move_pct=round(move_pct, 2),
            raw_pnl=round(raw_pnl, 4),
            net_pnl=round(net_pnl, 4),
        ))

    if not trades:
        print("  No qualifying trades found.")
        return pd.DataFrame()

    return pd.DataFrame(trades)


def compute_sharpe(pnl_series, periods_per_year=4):
    """Annualised Sharpe ratio (assumes quarterly trades)."""
    if len(pnl_series) < 2 or pnl_series.std() == 0:
        return np.nan
    return pnl_series.mean() / pnl_series.std() * np.sqrt(periods_per_year)


def factor_regression(trades_df, market_returns):
    """
    Simple factor regression:
        R_strategy = alpha + beta1*R_QQQ + beta2*DeltaVIX + beta3*JumpFactor + eps

    JumpFactor = |move_pct| - expected_move  (proxy)
    """
    if trades_df.empty or market_returns is None:
        return None

    df = trades_df.copy()
    df['date'] = pd.to_datetime(df['t_plus1'])
    df = df.set_index('date').sort_index()

    # Align market returns to trade dates
    mkt = market_returns.reindex(df.index, method='nearest')
    df['R_mkt'] = mkt.values

    # DeltaVIX proxy: abs(move_pct) as a rough vol-change signal
    df['delta_vix'] = df['move_pct'].abs() - df['move_pct'].abs().mean()

    # JumpFactor: realized move minus expected move (EP * S_entry * some scale)
    df['expected_move'] = df['EP'] * df['S_entry'] * 0.5
    df['jump_factor']   = df['move_pct'].abs() - df['expected_move']

    # OLS by hand (no statsmodels dependency)
    X = df[['R_mkt', 'delta_vix', 'jump_factor']].dropna()
    y = df.loc[X.index, 'net_pnl']
    if len(X) < 5:
        return None

    X_mat = np.column_stack([np.ones(len(X)), X.values])
    try:
        betas, _, _, _ = np.linalg.lstsq(X_mat, y.values, rcond=None)
    except Exception:
        return None

    labels = ['alpha', 'beta_QQQ', 'beta_DeltaVIX', 'beta_JumpFactor']
    return dict(zip(labels, betas))


