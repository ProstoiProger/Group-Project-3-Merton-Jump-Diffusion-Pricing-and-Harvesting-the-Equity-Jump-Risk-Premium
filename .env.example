# ─────────────────────────────────────────────────────────────────
# .env.example  —  copy to .env and edit.  .env is git-ignored.
# ─────────────────────────────────────────────────────────────────

# ── Merton Jump-Diffusion parameters (shared W3 + W4 baseline) ───
S0=100.0
STRIKE=100.0
MATURITY=1.0
RATE=0.05
SIGMA=0.20
LAMBDA=1.0
MU_J=-0.10
SIGMA_J=0.25

# ── Kou double-exponential extra parameters ───────────────────────
P_UP=0.40
ETA1=10.0
ETA2=5.0

# ── Monte Carlo runtime settings ─────────────────────────────────
PATHS=50000
STEPS=252
SEED=42
REPLICATIONS=5
MERTON_TERMS=150

# ── COS engine settings ───────────────────────────────────────────
COS_N=512
COS_L=10

# ── Data pipeline settings (W5) ───────────────────────────────────
TICKER=QQQ
DATA_PERIOD=3y
N_EXPIRIES=6
BNS_WINDOW=20
BNS_Z_THRESHOLD=2.0

# ── W6 Calibration settings ───────────────────────────────────────
# Bounds for differential_evolution global search
CALIB_SIGMA_MIN=0.05
CALIB_SIGMA_MAX=0.40
CALIB_LAMBDA_MIN=0.01
CALIB_LAMBDA_MAX=8.00
CALIB_MUJ_MIN=-0.50
CALIB_MUJ_MAX=0.05
CALIB_SIGMAJ_MIN=0.01
CALIB_SIGMAJ_MAX=0.40
# Kou bounds
CALIB_P_UP_MIN=0.05
CALIB_P_UP_MAX=0.95
CALIB_ETA1_MIN=1.10
CALIB_ETA1_MAX=50.0
CALIB_ETA2_MIN=0.50
CALIB_ETA2_MAX=50.0
# Optimizer settings
CALIB_DE_MAXITER=40
CALIB_DE_POPSIZE=12
CALIB_LBFGS_MAXITER=100
# Data filter settings
CALIB_T_MIN=0.05
CALIB_MONEYNESS_MIN=0.85
CALIB_MONEYNESS_MAX=1.15
CALIB_IV_MIN=0.10
CALIB_IV_MAX=0.60
# Regularisation
CALIB_REG_ALPHA=0.01
