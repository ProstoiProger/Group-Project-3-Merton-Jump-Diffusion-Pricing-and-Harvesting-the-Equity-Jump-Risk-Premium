# ─────────────────────────────────────────────────────────────────
# .env.example  —  copy to .env and edit.  .env is git-ignored.
# ─────────────────────────────────────────────────────────────────

# ── Merton Jump-Diffusion parameters (shared W3 + W4 baseline) ───
S0=100.0
STRIKE=100.0
MATURITY=1.0
RATE=0.05
SIGMA=0.20
LAMBDA=1.0
MU_J=-0.10
SIGMA_J=0.25

# ── Kou double-exponential extra parameters ───────────────────────
P_UP=0.40
ETA1=10.0
ETA2=5.0

# ── Monte Carlo runtime settings ─────────────────────────────────
PATHS=50000
STEPS=252
SEED=42
REPLICATIONS=5
MERTON_TERMS=150

# ── COS engine settings ───────────────────────────────────────────
COS_N=512
COS_L=10

# ── Data pipeline settings (W5) ───────────────────────────────────
TICKER=QQQ
DATA_PERIOD=3y
N_EXPIRIES=6
BNS_WINDOW=20
BNS_Z_THRESHOLD=2.0
